<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>orderprocessing-api-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Talks to Service Bus. Auth is via Azure.Identity (managed identity / workload identity),
         never a connection string, so no secret package is referenced for Service Bus. -->
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.18.1" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />

    <!-- Talks to Redis for order status storage (cache-aside pattern). -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />

    <!-- Health check UI package for a richer /health response. -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderProcessing.Shared\OrderProcessing.Shared.csproj" />
  </ItemGroup>

</Project>
